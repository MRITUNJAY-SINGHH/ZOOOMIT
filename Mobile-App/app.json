{
  "expo": {
    "name": "ZOOOMIT",
    "slug": "zooomit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zooomit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.zooomit.app"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.zooomit.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#059669",
          "image": "./assets/images/logo.jpg",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "a21518a8-4a05-4bcf-a9ab-19156020677d"
      },
      "router": {}
    },
    "owner": "aeterns-team"
  }
}
