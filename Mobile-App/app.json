{
  "expo": {
    "name": "ZOOOMIT",
    "slug": "zooomit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.jpg",
    "scheme": "zooomit",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "icon": "./assets/images/logo.jpg",
      "bundleIdentifier": "com.zooomit.app",
      "splash": {
        "image": "./assets/images/logo.jpg",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF"
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.zooomit.app",
      "splash": {
        "image": "./assets/images/logo.jpg",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/logo.jpg",
          "imageWidth": 220
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "a21518a8-4a05-4bcf-a9ab-19156020677d"
      },
      "router": {}
    },
    "owner": "aeterns-team"
  }
}
